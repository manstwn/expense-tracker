# Runtime
ENV=dev
PORT=3000

# AI Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# Database Configuration
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/dbname
MONGODB_DB_NAME=personal-tracker-db

# Owner / Authentication
# WEB_PIN must be at least 6 characters. Do not use 1234.
WEB_PIN=choose-a-pin-of-at-least-6-characters
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTHORIZED_USER_ID=123456789
OWNER_USERNAME=owner

# IoT display (optional). If empty, /iot returns 503.
IOT_TOKEN=replace-with-a-device-token

# Cloudflare Tunnel (optional, used when ENV=prod)
CL_TUNNEL_TOKEN=
